# Copy this file to a new file named exactly:  .env
# Then replace the placeholder values. NEVER share or upload your real .env file.

# Long random text that signs login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value

# MySQL connection (type your password exactly as it is, no encoding needed)
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=moodify_db

# Optional: a full connection string overrides the DB_* values above
# DATABASE_URL=
